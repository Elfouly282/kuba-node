{
  "info": {
    "name": "Kuba",
    "_postman_id": "kuba-v1",
    "description": "Kuba API collection. Grouped by screen/feature.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://kuba-app.com/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT — set automatically after login / signup"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string",
      "description": "Reset token — set automatically after verify-reset-otp"
    }
  ],
  "item": [
    {
      "name": "Home",
      "description": "Public home screen endpoints — no authentication required.",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Returns all categories with full image URLs."
          }
        },
        {
          "name": "Get All Banners",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/banners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners"
              ]
            },
            "description": "Returns all banners with full image URLs. Supports optional query parameters: position (top, center, bottom) and region (regionId)."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "All user authentication endpoints grouped by flow.",
      "item": [
        {
          "name": "Flow 1 — Sign Up & Email Verification",
          "description": "New user registers, then verifies their email.",
          "item": [
            {
              "name": "Step 1 — Sign Up",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/signup",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "signup"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"+201234567890\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"acceptTerms\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Register a new user. Returns a JWT immediately. A verification email is sent in the background."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Step 2 — Verify Email",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/auth/verify-email/:token",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "verify-email",
                    ":token"
                  ],
                  "variable": [
                    {
                      "key": "token",
                      "value": "<RAW_TOKEN_FROM_EMAIL>"
                    }
                  ]
                }
              }
            },
            {
              "name": "Step 3 — Resend Verification Email",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/resend-verification",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "resend-verification"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "name": "Flow 2 — Login",
          "description": "Existing user logs in with email/password or Google.",
          "item": [
            {
              "name": "Login (Email & Password)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "login"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Login (Google / Firebase)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/google",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "google"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firebaseIdToken\": \"<FIREBASE_ID_TOKEN_HERE>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/logout",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "logout"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('token', '');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Flow 3 — Forgot Password",
          "description": "Step 1 → Step 2 → Step 3 must be done in order.",
          "item": [
            {
              "name": "Step 1 — Forgot Password (send OTP)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/forgot-password",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "forgot-password"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Step 2 — Verify Reset OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/verify-reset-otp",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "verify-reset-otp"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"otp\": \"123456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.resetToken) pm.collectionVariables.set('resetToken', res.resetToken);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Step 3 — Reset Password",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/reset-password/{{resetToken}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "reset-password",
                    "{{resetToken}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"password\": \"NewPassword123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);",
                      "pm.collectionVariables.set('resetToken', '');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Flow 4 — Profile & Account (logged in)",
          "description": "Requires Bearer token.",
