  "item": [
    {
      "name": "Auth",
      "description": "دخول بوابة صاحب الإعلان.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "حساب role = owner أو advertiser. الرد فيه ownedAds، وأول إعلان يتحفظ في advertisementId.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set(\"token\", res.token);",
                  "const user = res.data && res.data.user;",
                  "if (user) {",
                  "  const id = user.id || user._id;",
                  "  if (id) pm.collectionVariables.set(\"userId\", String(id));",
                  "  const ads = user.ownedAds || [];",
                  "  if (ads[0]) {",
                  "    const adId = ads[0].id || ads[0]._id;",
                  "    if (adId) {",
                  "      pm.collectionVariables.set(\"advertisementId\", String(adId));",
                  "      pm.collectionVariables.set(\"hotelId\", String(adId));",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "me"
              ]
            },
            "description": "بيانات صاحب الإعلان وقائمة إعلاناته ownedAds."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const user = res.data && res.data.user;",
                  "if (!user) return;",
                  "const id = user.id || user._id;",
                  "if (id) pm.collectionVariables.set(\"userId\", String(id));",
                  "const ads = user.ownedAds || [];",
                  "if (ads[0]) {",
                  "  const adId = ads[0].id || ads[0]._id;",
                  "  if (adId) {",
                  "    pm.collectionVariables.set(\"advertisementId\", String(adId));",
                  "    pm.collectionVariables.set(\"hotelId\", String(adId));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
