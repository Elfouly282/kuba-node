{
  "info": {
    "name": "Kuba",
    "_postman_id": "kuba-v1",
    "description": "Kuba user API. Public reads plus the logged-in user account and bookings. No admin endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://kuba-app.com/api/v1",
      "type": "string",
      "description": "API base URL (Production: https://kuba-app.com/api/v1 | Local: http://localhost:3000/api/v1)"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT — set automatically after login / signup"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string",
      "description": "Reset token — set automatically after verify-reset-otp"
    },
    {
      "key": "cityId",
      "value": "6ad616031ddbe497b5dd4416",
      "type": "string",
      "description": "City ID (Sahl Hasheesh: 6ad616031ddbe497b5dd4416)"
    }
  ],
  "item": [
    {
      "name": "Home",
      "description": "Public home screen endpoints — no authentication required.",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Returns all categories with full image URLs."
          }
        },
        {
          "name": "Get All Banners",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/banners?city={{cityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "{{cityId}}",
                  "description": "Filter banners by City ID (e.g. Sahl Hasheesh)",
                  "disabled": false
                },
                {
                  "key": "region",
                  "value": "<REGION_ID>",
                  "description": "Filter banners by Region ID",
                  "disabled": true
                },
                {
                  "key": "position",
                  "value": "top",
                  "description": "Filter by position (top, center, bottom)",
                  "disabled": true
                }
              ]
            },
            "description": "Returns all banners with full image URLs. Supports optional query parameters: position (top, center, bottom) and region (regionId)."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "All user authentication endpoints grouped by flow.",
      "item": [
        {
          "name": "Flow 1 — Sign Up & Email Verification",
          "description": "New user registers, then verifies their email.",
          "item": [
            {
              "name": "Step 1 — Sign Up",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/signup",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "signup"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"+201234567890\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"acceptTerms\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Register a new user. Returns a JWT immediately. A verification email is sent in the background."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Step 2 — Verify Email",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/auth/verify-email/:token",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "verify-email",
                    ":token"
                  ],
                  "variable": [
                    {
                      "key": "token",
                      "value": "<RAW_TOKEN_FROM_EMAIL>"
                    }
                  ]
                }
              }
            },
            {
              "name": "Step 3 — Resend Verification Email",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/resend-verification",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "resend-verification"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "name": "Flow 2 — Login",
          "description": "Existing user logs in with email/password or Google.",
          "item": [
            {
              "name": "Login (Email & Password)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "login"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Login (Google / Firebase)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/google",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "google"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firebaseIdToken\": \"<FIREBASE_ID_TOKEN_HERE>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/logout",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "logout"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('token', '');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Flow 3 — Forgot Password",
          "description": "Step 1 → Step 2 → Step 3 must be done in order.",
          "item": [
            {
              "name": "Step 1 — Forgot Password (send OTP)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/forgot-password",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "forgot-password"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Step 2 — Verify Reset OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/verify-reset-otp",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "verify-reset-otp"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"otp\": \"123456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.resetToken) pm.collectionVariables.set('resetToken', res.resetToken);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Step 3 — Reset Password",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/reset-password/{{resetToken}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "reset-password",
                    "{{resetToken}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"password\": \"NewPassword123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);",
                      "pm.collectionVariables.set('resetToken', '');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Flow 4 — Profile & Account (logged in)",
          "description": "Requires Bearer token.",
          "item": [
            {
              "name": "Get My Profile",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/me",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "me"
                  ]
                }
              }
            },
            {
              "name": "Update Profile",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/update-profile",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "update-profile"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Updated Name\",\n  \"avatar\": \"https://example.com/avatar.jpg\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Change Password",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/change-password",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "change-password"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"Password123\",\n  \"newPassword\": \"NewPassword456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Select City (Favorite City)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/select-city",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "select-city"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"cityId\": \"{{cityId}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Saves the user's selected/favorite city. Supports cityId in body or query param."
              }
            },
            {
              "name": "Select Region",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/select-region",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "select-region"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"regionId\": \"<REGION_ID>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Delete Account",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/delete-account",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "delete-account"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('token', '');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Onboarding",
      "description": "Onboarding screens — public.",
      "item": [
        {
          "name": "Get All Onboarding Screens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/onboarding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "onboarding"
              ]
            },
            "description": "Returns all active onboarding screens in display order."
          }
        }
      ]
    },
    {
      "name": "Cities",
      "description": "Cities the user can browse. Each city can contain sub-regions.",
      "item": [
        {
          "name": "Get All Cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cities"
              ],
              "query": [
                {
                  "key": "active",
                  "value": "true",
                  "description": "Filter by active status (true/false)",
                  "disabled": true
                }
              ]
            },
            "description": "Returns all cities with their images, colors, centers, points, and regions count."
          }
        },
        {
          "name": "Get One City",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cities",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{cityId}}",
                  "description": "City ObjectId (e.g. Sahl Hasheesh: 6ad616031ddbe497b5dd4416)"
                }
              ]
            },
            "description": "Returns details of a single city including its zone points, center, and regions count."
          }
        },
        {
          "name": "Get City Regions (Sub-Areas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities/:id/regions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cities",
                ":id",
                "regions"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{cityId}}",
                  "description": "City ObjectId"
                }
              ],
              "query": [
                {
                  "key": "active",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "description": "Returns all sub-regions/areas belonging to this city (e.g., Jamaran, Azzurra, Old Town, Al Saraya, Al Andalous, Al Qasr, Piazza)."
          }
        },
        {
          "name": "Get City Screen Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities/:id/data?position=top",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cities",
                ":id",
                "data"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{cityId}}",
                  "description": "City ObjectId (or pass in query ?cityId=...)"
                }
              ],
              "query": [
                {
                  "key": "position",
                  "value": "top",
                  "description": "Filter banners by position: top, center, bottom"
                }
              ]
            },
            "description": "Returns aggregated data for the City screen: city details, list of sub-regions inside the city, city-specific banners, chalets, all advertisements, and categories."
          }
        }
      ]
    },
    {
      "name": "Regions",
      "description": "Endpoints for sub-regions and areas (e.g. Jamaran, Azzurra, Old Town) belonging to a parent City (e.g. Sahl Hasheesh).",
      "item": [
        {
          "name": "Get All Regions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/regions?city={{cityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "regions"
              ],
              "query": [
                {
                  "key": "active",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "city",
                  "value": "{{cityId}}",
                  "description": "Filter regions by parent City ID (e.g. Sahl Hasheesh)",
                  "disabled": false
                }
              ]
            },
            "description": "Returns all regions. Each region includes points [{latitude, longitude}], color (default #2D4F2E), center {latitude, longitude}, and boundaries (GeoJSON Polygon, set when points has at least 3 vertices). Optional: ?active=true|false"
          }
        },
        {
          "name": "Get Region Data (by query param)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/regions/data?regionId=<REGION_ID>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "regions",
                "data"
              ],
              "query": [
                {
                  "key": "regionId",
                  "value": "<REGION_ID>"
                }
              ]
            },
            "description": "Returns the region plus its banners, chalets, advertisements, and categories. Advertisements include listings assigned to this region and listings whose latitude/longitude fall inside the region zone (when the zone has at least 3 points). Pass regionId as a query param."
          }
        },
        {
          "name": "Get One Region",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/regions/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "regions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<REGION_ID>"
                }
              ]
            },
            "description": "Returns one region, including points, color, center, and boundaries."
          }
        },
        {
          "name": "Get Region Data (by path param)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/regions/:id/data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "regions",
                ":id",
                "data"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<REGION_ID>"
                }
              ]
            },
            "description": "Same payload as Get Region Data (by query param). Region id is in the path. Advertisements include listings inside the zone, not only listings whose region field matches."
          }
        }
      ]
    },
    {
      "name": "Advertisements",
      "description": "Listings for the user: search, list, and open one advertisement. Filters can be used together or one at a time.",
      "item": [
        {
          "name": "Search Listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?category=<CATEGORY_ID>&guests=4&city={{cityId}}&regions=<REGION_ID>&startDate=2026-11-01&endDate=2026-11-10&duration=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "<CATEGORY_ID>",
                  "description": "Optional. One category id, or several separated by commas. Matched listings must be in one of them."
                },
                {
                  "key": "guests",
                  "value": "4",
                  "description": "Optional. Whole number. Listing capacity (guests_count, max_passengers, or passengers) must be at least this number."
                },
                {
                  "key": "city",
                  "value": "{{cityId}}",
                  "description": "Optional. One city id, or several separated by commas. A listing matches if it belongs to one of the cities or its coordinates fall inside that city zone."
                },
                {
                  "key": "regions",
                  "value": "<REGION_ID>",
                  "description": "Optional. One or more region ids, comma-separated. A listing matches if it belongs to one of the regions or its coordinates fall inside that region zone."
                },
                {
                  "key": "startDate",
                  "value": "2026-11-01",
                  "description": "Optional, together with endDate. Start of the time window."
                },
                {
                  "key": "endDate",
                  "value": "2026-11-10",
                  "description": "Optional, together with startDate. End of the time window."
                },
                {
                  "key": "duration",
                  "value": "3",
