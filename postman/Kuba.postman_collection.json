    {
      "name": "Onboarding",
      "description": "Onboarding screens — public.",
      "item": [
        {
          "name": "Get All Onboarding Screens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/onboarding",
              "host": [
                "{{baseUrl}}"
              ],
