{
  "info": {
    "name": "Kuba",
    "_postman_id": "kuba-v1",
    "description": "Kuba API collection. Grouped by screen/feature.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://kuba-app.com/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT — set automatically after login / signup"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string",
      "description": "Reset token — set automatically after verify-reset-otp"
    }
  ],
  "item": [
    {
      "name": "Home",
      "description": "Public home screen endpoints — no authentication required.",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Returns all categories with full image URLs."
          }
        },
        {
          "name": "Get One Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<CATEGORY_ID>"
                }
              ]
            },
            "description": "Returns a single category by ID."
          }
        },
        {
          "name": "Get All Banners",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/banners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners"
              ]
            },
            "description": "Returns all banners with full image URLs."
          }
        },
        {
          "name": "Get One Banner",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/banners/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<BANNER_ID>"
                }
              ]
            },
            "description": "Returns a single banner by ID."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "All user authentication endpoints grouped by flow.",
      "item": [
        {
          "name": "Flow 1 — Sign Up & Email Verification",
          "description": "New user registers, then verifies their email.\nStep 1 → Step 2 (or Step 3 if they need to resend).",
          "item": [
            {
              "name": "Step 1 — Sign Up",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/signup",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "signup"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"+201234567890\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"acceptTerms\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Register a new local user.\n\nRequired: email, password, confirmPassword, acceptTerms (true)\nOptional: name, phone\n\nReturns a JWT immediately. A verification email is sent in the background."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Step 2 — Verify Email",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/auth/verify-email/:token",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "verify-email",
                    ":token"
                  ],
                  "variable": [
                    {
                      "key": "token",
                      "value": "<RAW_TOKEN_FROM_EMAIL>",
                      "description": "Raw token from the verification email link"
                    }
                  ]
                },
                "description": "Verify the user's email using the token sent in the verification email."
              }
            },
            {
              "name": "Step 3 — Resend Verification Email (if needed)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/resend-verification",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "resend-verification"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Resend the email verification link.\nAlways responds with success even if the email does not exist (anti-enumeration)."
              }
            }
          ]
        },
        {
          "name": "Flow 2 — Login",
          "description": "Existing user logs in with email/password or Google.",
          "item": [
            {
              "name": "Login (Email & Password)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "login"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Login with email & password (local accounts only).\nReturns a JWT."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Login (Google / Firebase)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/google",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "google"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firebaseIdToken\": \"<FIREBASE_ID_TOKEN_HERE>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Login via Google using a Firebase ID token.\nThe token can also be sent as: Authorization: Bearer <token>\n\nReturns a Kuba JWT plus the user's Google profile (uid, email, name, picture)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/logout",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "logout"
                  ]
                },
                "description": "Stateless logout — token invalidation is handled client-side by discarding the JWT.\nRequires: Bearer token"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('token', '');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Flow 3 — Forgot Password (not logged in)",
          "description": "User forgot their password and needs to reset it.\nStep 1 → Step 2 → Step 3 (must be done in order).",
          "item": [
            {
              "name": "Step 1 — Forgot Password (send OTP)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/forgot-password",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "forgot-password"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Send a 6-digit OTP to the user's email.\nOTP is valid for 10 minutes.\nAlways responds with success even for unknown or Google accounts (anti-enumeration)."
              }
            },
            {
              "name": "Step 2 — Verify Reset OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/verify-reset-otp",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "verify-reset-otp"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"otp\": \"123456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Verify the OTP received by email.\n\nRequired: email, otp (6-digit code)\n\nOn success returns a short-lived resetToken — pass it in Step 3.\nThe OTP is consumed and cannot be reused."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.resetToken) pm.collectionVariables.set('resetToken', res.resetToken);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Step 3 — Reset Password",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/reset-password/{{resetToken}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "reset-password",
                    "{{resetToken}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"password\": \"NewPassword123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Set a new password using the resetToken from Step 2.\nThe token is passed in the URL and is valid for 10 minutes.\n\nReturns a new JWT — user is logged in immediately after reset."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);",
                      "pm.collectionVariables.set('resetToken', '');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Flow 4 — Profile & Account (logged in)",
          "description": "All actions that require the user to be authenticated.\nSet the {{token}} variable first (via Login or Sign Up).",
          "item": [
            {
              "name": "Get My Profile",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/me",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "me"
                  ]
                },
                "description": "Returns the currently authenticated user's profile.\nRequires: Bearer token"
              }
            },
            {
              "name": "Update Profile",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/update-profile",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "update-profile"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Updated Name\",\n  \"avatar\": \"https://example.com/avatar.jpg\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Update name and/or avatar URL.\nOnly these two fields are accepted — all others are ignored.\nRequires: Bearer token"
              }
            },
            {
              "name": "Change Password",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/change-password",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "change-password"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"Password123\",\n  \"newPassword\": \"NewPassword456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Change password while logged in.\nNew password must differ from the current one.\nReturns a new JWT.\nRequires: Bearer token"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) pm.collectionVariables.set('token', res.token);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Delete Account",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/delete-account",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "delete-account"
                  ]
                },
                "description": "Soft-delete the authenticated user's account (sets active: false).\nThe account becomes invisible in all future queries.\nRequires: Bearer token"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('token', '');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}