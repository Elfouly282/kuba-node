{
  "info": {
    "name": "Kuba - User Auth",
    "_postman_id": "kuba-user-auth-v2",
    "description": "All user authentication endpoints for the Kuba API.\nEndpoints are grouped by flow so the frontend team can follow each journey end-to-end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string",
      "description": "Change to https://kuba-app.com/api/v1 for production"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT — set automatically after login / signup"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string",
      "description": "Reset token — set automatically after verify-reset-otp"
    }
  ],
  "item": [
    {
      "name": "Banners",
      "description": "CRUD endpoints for banners. GET endpoints are public. POST / PATCH / PUT / DELETE require admin JWT.",
      "item": [
        {
          "name": "Get All Banners",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/banners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners"
              ]
            }
          }
        },
        {
          "name": "Get One Banner",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/banners/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<BANNER_ID>"
                }
              ]
            }
          }
        },
        {
          "name": "Create Banner (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/banners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "advertisementId",
                  "value": "<ADVERTISEMENT_ID>",
                  "type": "text"
                }
              ]
            },
            "description": "Requires: image (file upload) and advertisementId.\nAdmin only."
          }
        },
        {
          "name": "Update Banner (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/banners/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<BANNER_ID>"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "advertisementId",
                  "value": "<ADVERTISEMENT_ID>",
                  "type": "text"
                }
              ]
            },
            "description": "All fields are optional — send only what needs to change.\nAdmin only."
          }
        },
        {
          "name": "Delete Banner (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/banners/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "banners",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<BANNER_ID>"
                }
              ]
            },
            "description": "Admin only."
          }
        }
      ]
    },
