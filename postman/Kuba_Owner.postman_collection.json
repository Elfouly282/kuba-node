{
  "info": {
    "name": "Kuba — Ad Owner",
    "_postman_id": "kuba-ad-owner",
    "description": "مجموعة طلبات بوابة صاحب الإعلان (role: owner أو advertiser).\nنفس تسجيل دخول الداشبورد: POST /admin/auth/login.\nقائمة الإعلانات والحجوزات بتترشح تلقائي على إعلاناته فقط.\nتعديل إعلان أو صوره أو غرفه مسموح لإعلاناته فقط.\nتعيين المالك وإدارة المستخدمين والمدن والأقسام للأدمن فقط وغير موجودة هنا.\nتحديث البروفايل وتغيير الباسورد في البوابة بينادوا PATCH /admin/users/:id وهذا المسار حالياً requireAdmin، فهيرجع 403 لصاحب الإعلان.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://kuba-app.com/api/v1",
      "type": "string",
      "description": "Production: https://kuba-app.com/api/v1 | Local: http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT. يتحفظ تلقائي بعد Login."
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "advertisementId",
      "value": "",
      "type": "string"
    },
    {
      "key": "hotelId",
      "value": "",
      "type": "string"
    },
    {
      "key": "roomId",
      "value": "",
      "type": "string"
    },
